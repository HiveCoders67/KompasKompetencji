# Web app (apps/web) — Firebase web config of the project (public values).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# true = connect to local emulators (npm run emulators)
VITE_FIREBASE_USE_EMULATOR=false

# The Gemini API key is NOT configured here — it lives only in Cloud Functions:
#   npx firebase functions:secrets:set GEMINI_API_KEY
# (emulator: functions/.secret.local)
